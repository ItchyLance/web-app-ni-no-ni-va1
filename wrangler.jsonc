{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-ni-no-ni-va1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d8f88278-93e4-46c5-97c9-4abb8707dbb1","database_name": "web-app-ni-no-ni-va1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ae74eaf0a3ac43028a2ed731193a3aa4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
